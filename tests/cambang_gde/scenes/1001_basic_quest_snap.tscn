script/source = "extends Control
# NOT FOR AUTOMATED / CLI TESTING
# MANUAL, INTERACTIVE, TESTING ONLY
const WAIT_BEFORE_QUIT = 1.0
const RIG_A_CAMERA_DESCRIPTION_JSON := \"{\\\"schema_version\\\":2,\\\"cameras\\\":[{\\\"camera_id\\\":\\\"50\\\"},{\\\"camera_id\\\":\\\"51\\\"}],\\\"concurrent_camera_support\\\":{\\\"supported\\\":true,\\\"camera_id_combinations\\\":[[\\\"50\\\",\\\"51\\\"]]}}\"
#const RIG_A_CAMERA_DESCRIPTION_JSON := \"{\\\"schema_version\\\":2,\\\"cameras\\\":[{\\\"camera_id\\\":\\\"0\\\"},{\\\"camera_id\\\":\\\"1\\\"}],\\\"concurrent_camera_support\\\":{\\\"supported\\\":true,\\\"camera_id_combinations\\\":[[\\\"0\\\",\\\"1\\\"]]}}\"



const FAKE_LOCATION := {\"latitude_degrees\": 55.9533, \"longitude_degrees\": -3.1883,}
var device_00 : CamBANGDevice 
var device_01 : CamBANGDevice 

var rig_00 : CamBANGRig

var stream_00 : CamBANGStream 
var stream_01 : CamBANGStream 


var request_time : int 
#var capture_profile_00 : Dictionary = {
	#\"width\": 1280,
	#\"height\": 720,
	#\"format_fourcc\": 0x00000020, # use the project/provider FOURCC value you intend
	#\"still_image_bundle\": {
		#\"members\": [
			#{
				#\"image_member_index\": 0,
				#\"role\": \"DEFAULT_METERED\",
				#\"intended_exposure_compensation_milli_ev\": 0,
			#},
		#],
	#},
#}

var capture_profile_00 : Dictionary = {
	\"width\":1280,#800,
	\"height\": 1280,#600,
	\"still_image_bundle\": {
		\"members\": [
		{
			\"image_member_index\": 0,
			\"role\": CamBANGCaptureResult.IMAGE_ROLE_DEFAULT_METERED,
			\"intended_exposure_compensation_milli_ev\": 0,
		},
		#{
			#\"image_member_index\": 1,
			#\"role\": CamBANGCaptureResult.IMAGE_ROLE_ADDITIONAL_BRACKET,
			#\"intended_exposure_compensation_milli_ev\": -4000,
		#},
		#{
			#\"image_member_index\": 2,
			#\"role\": CamBANGCaptureResult.IMAGE_ROLE_ADDITIONAL_BRACKET,
			#\"intended_exposure_compensation_milli_ev\": 4000,
		#},
		]
	},
}


func _display_path_kind_name(path_kind: int) -> String:
	match path_kind:
		CamBANGStreamResult.DISPLAY_PATH_RETAINED_GPU_BACKING:
			return \"retained_gpu_backing\"
		CamBANGStreamResult.DISPLAY_PATH_STREAM_LIVE_CPU_DISPLAY_VIEW:
			return \"stream_live_cpu_display_view\"
		_:
			return \"none\"


func _plan_posture_is_gpu(posture: String) -> bool:
	return posture.begins_with(\"GPU-primary\")

func _ready():
	var camera_permission = \"android.permission.CAMERA\"
	if OS.get_granted_permissions().has(camera_permission):
		print(\"Camera permission already granted!\")
	else:
		# Request the permission from the user
		OS.request_permissions()
		await get_tree().create_timer(5.0).timeout
		
	CamBANGServer.ingest_camera_description(RIG_A_CAMERA_DESCRIPTION_JSON)
	CamBANGServer.set_capture_geolocation(FAKE_LOCATION)
	#CamBANGServer.start(CamBANGServer.PROVIDER_KIND_SYNTHETIC)
	CamBANGServer.start(CamBANGServer.PROVIDER_KIND_PLATFORM_BACKED)
	var endpoints: Array = CamBANGServer.enumerate_devices()
	if endpoints.is_empty():
		push_error(\"KERR No CamBANG endpoints\")
		return

	var endpoint = endpoints[0]
	print(\"ENDPOINTS: \", endpoints)
	if typeof(endpoint) != TYPE_DICTIONARY:
		push_error(\"KERR Endpoint entry was not a Dictionary\")
		return

	var hardware_id: String = str(endpoint.get(\"hardware_id\", \"\"))
	if hardware_id.is_empty():
		push_error(\"KERR Endpoint had no hardware_id\")
		return
	
	## synthetic:0
	#device_00 = CamBANGServer.get_device_for_hardware_id(\"synthetic:0\")
	#CamBANGServer.get_device()
	
	## razer built-in
	#device_00 = CamBANGServer.get_device_for_hardware_id(\"\\\\\\\\?\\\\USB#VID_13D3&PID_5279&MI_00#6&f7bbb15&0&0000#{e5323777-f976-4f5b-9b55-b94699c46e44}\\\\GLOBAL\")

	## usb
	#device_00 = CamBANGServer.get_device_for_hardware_id(\"\\\\\\\\?\\\\USB#VID_328F&PID_002D&MI_00#6&eb63420&2&0000#{e5323777-f976-4f5b-9b55-b94699c46e44}\\\\GLOBAL\")

	## Camera2 device 0
	#device_00 = CamBANGServer.get_device_for_hardware_id(\"0\")

	## Quest 3 
	device_00 = CamBANGServer.get_device_for_hardware_id(\"50\")
	device_01 = CamBANGServer.get_device_for_hardware_id(\"51\")

	### S20+
	#device_00 = CamBANGServer.get_device_for_hardware_id(\"0\")
	#device_01 = CamBANGServer.get_device_for_hardware_id(\"1\")

	#var device_01 : CamBANGDevice = CamBANGServer.get_device_for_hardware_id(\"synthetic:1\")
	device_00.set_still_capture_profile(capture_profile_00)
	device_01.set_still_capture_profile(capture_profile_00)

	
	device_00.engage()
	device_01.engage()

	while not device_00.live:
		await device_00.live_changed

	while not device_01.live:
		await device_01.live_changed
	#var stream_00 : CamBANGStream = device_00.create_stream()

	rig_00 = CamBANGServer.create_rig(PackedStringArray([\"50\", \"51\"]))
	#rig_00 = CamBANGServer.create_rig(PackedStringArray([\"0\", \"1\"]))

	print(\"Made a rig? %s\" % [rig_00])

	stream_00 = device_00.create_stream(({
	\"intent\": CamBANGStream.INTENT_VIEWFINDER,
	\"profile\": {
		\"width\": 1280,#800,
		\"height\": 1280,#600,
		\"format_fourcc\": CamBANGServer.PIXEL_FORMAT_RGBA,
		\"target_fps_min\": 30,
		\"target_fps_max\": 30,
		}
	}))
	
	stream_01 = device_01.create_stream(({
	\"intent\": CamBANGStream.INTENT_VIEWFINDER,
	\"profile\": {
		\"width\": 1280,#800,
		\"height\": 1280,#600,
		\"format_fourcc\": CamBANGServer.PIXEL_FORMAT_RGBA,
		\"target_fps_min\": 30,
		\"target_fps_max\": 30,
		}
	}))
	
	stream_00.start()
	stream_01.start()

	while not stream_00.result_live:
		await stream_00.result_live_changed
			
	var stream_result := stream_00.get_result()
	if stream_result == null:
		push_error(\"KERR stream result unexpectedly null after result_live\")
		return
#
	%StreamDisplayTexture.texture = stream_result.get_display_view()
	
	
	##-------------------------
	#await get_tree().create_timer(50.0).timeout
	#print(\"HERE I AM FUCKER\")
	#stream_00.stop()
	#stream_00.destroy()
	##stream_00_b.destroy()
	##CamBANGServer.stop()
	#%StreamDisplayTexture.texture = null
	#var huh = device_00.disengage()
	#print(\"Huh?: %s\" % huh)


func _process(delta: float) -> void:
	pass


func _do_capture():
	var capture_err = rig_00.trigger_capture()#device_00.trigger_capture()
	print(\"capture_err %s\" % capture_err)
	#while rig_00.get_result() == []:#null:
		##print(\"waiting\")
		#await get_tree().process_frame
	
	await get_tree().create_timer(0.5).timeout # arbitrary and horible. Only temporary
	
	var rig_results : Array[CamBANGCaptureResult] = rig_00.get_result()
	print(\"stopped waiting. Results are: %s\" % [rig_results])
	var capture_result : CamBANGCaptureResult = null
	if not rig_results == []:
		capture_result = rig_results[0]
	print(\"capture_result: %s\" % [capture_result])
	
	
	#var stream_result : CamBANGStreamResult = stream_00.get_result()

	if not capture_result == null:
		print(\"KERR there is a capture_result\")
		%CaptureDisplayTexture00.texture = ImageTexture.create_from_image(rig_results[0].to_image())
		%CaptureDisplayTexture01.texture = ImageTexture.create_from_image(rig_results[1].to_image())

	#print(\"KERR: GEO %s\" % capture_result.get_geolocation())
	#print(\"KERR: OPTICAL CALIBRATION %s\" % capture_result.get_image_properties())


	#var member: Dictionary = capture_result.get_image_member(0)
	#var member01: Dictionary = capture_result.get_image_member(1)


		%CaptureInfoText00.text = _build_info_string(rig_results[0])
		%CaptureInfoText01.text = _build_info_string(rig_results[1])

	#%CaptureInfoText.text = str(\"pose: \", p, \"\\nDistortion: \", d, \"\\nIntrinsics: \", k)
	#var facts01: Dictionary = member01[\"camera_facts\"]

	#%CaptureInfoText01.text = str(\"Time: %s\\nISO: %s\" % [facts01[\"acquisition_timing\"], facts01[\"sensor_sensitivity_iso\"]])

	#%CaptureInfoText.text += str(\"\\nGEO: \", capture_result.get_geolocation())
	#%CaptureInfoText.text += str(\"\\nMembers: \", capture_result.get_image_count())
func _do_teardown():
	# some stuff
	await get_tree().create_timer(WAIT_BEFORE_QUIT).timeout
	get_tree().quit()

func _input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and not event.echo:
		var key_event := event as InputEventKey
		if key_event.keycode == KEY_ESCAPE:
			%SceneInfoText.text += \"Esc pressed; quitting scene\\n\"
			_do_teardown()
	#
#func _build_concurrency_truth(cameras: Array, combinations: Array) -> String:
	#var camera_dicts := []
	#for c in cameras:
		#camera_dicts.append({\"camera_id\": str(c)})
	#var combos := []
	#for combo in combinations:
		#var ids := []
		#for c in combo:
			#ids.append(str(c))
		#combos.append(ids)
	#return JSON.stringify({
		#\"schema_version\": 2,
		#\"cameras\": camera_dicts,
		#\"concurrent_camera_support\": {
			#\"supported\": combos.size() > 0,
			#\"camera_id_combinations\": combos,
		#},
	#})

func _build_info_string(ResultPacket : CamBANGCaptureResult, member: int = 0) -> String:
	var result_member: Dictionary = ResultPacket.get_image_member(member)
	var p: Dictionary
	var d: Dictionary
	var k: Dictionary
	var exposure_nanoseconds : int = -1
	var acq_mark : int = -1

	
	if result_member.has(\"camera_facts\"):

		var facts: Dictionary = result_member[\"camera_facts\"]
		print(\"Facts don't do what you want them to: %s\" % facts)
		
		if facts.has(\"facing\"):
			print(facts[\"facing\"][\"value\"], \" origin=\", facts[\"facing\"][\"origin\"])
		
		if facts.has(\"sensor_orientation_degrees\"):
			print(\"Sensor orientation: \", facts[\"sensor_orientation_degrees\"][\"value\"])
	
		if facts.has(\"intrinsics\"):
			var kf = facts[\"intrinsics\"]
			print(\"Intrinsics: \", kf[\"focal_length_x_px\"], kf[\"focal_length_y_px\"],
			kf[\"principal_point_x_px\"], kf[\"principal_point_y_px\"])
		
		if facts.has(\"focus_state\"):
			print(\"focus state %s\" % [facts[\"focus_state\"][\"state\"]])  # \"infinity\" in the one case we report
	
		if facts.has(\"intrinsics\"):
			k = facts[\"intrinsics\"]
		# \"focal_length_x_px\", \"focal_length_y_px\",
		# \"principal_point_x_px\", \"principal_point_y_px\",
		# optional \"skew_px\", \"reference_width_px\", \"reference_height_px\",
		# coordinate-domain keys, and \"origin\" (who supplied it)
		if facts.has(\"distortion\"):
			d = facts[\"distortion\"]
		# e.g. \"model\": \"brown_conrady_5\", radial_k1..k3, tangential_p1/p2,
		# reference geometry, \"origin\"
		if facts.has(\"pose\"):
			p = facts[\"pose\"]
			
		if facts.has(\"exposure_time\"):
			exposure_nanoseconds = facts[\"exposure_time\"][\"nanoseconds\"]
		#%CaptureInfoText00.text = str(\"Time: %s\\nISO: %s\\nPose: %s\" % [facts[\"acquisition_timing\"], facts[\"sensor_sensitivity_iso\"], p])
		
		var timing_v = facts.get(\"acquisition_timing\", null)
		if typeof(timing_v) == TYPE_DICTIONARY:
			var timing: Dictionary = timing_v
			if timing.has(\"acquisition_mark\"):
				acq_mark = int(timing.get(\"acquisition_mark\", 0))
		
	return str(\"Pose: %s\\nAcquisition mark (ms): %s\\nExposureTime (ms): %s\" % [p, acq_mark  / 1000000, exposure_nanoseconds / 1000000])
	
"

